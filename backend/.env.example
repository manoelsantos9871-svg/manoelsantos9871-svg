NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://healthtech:healthtech_secret@localhost:5432/healthtech_db

REDIS_URL=redis://localhost:6379

JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
